# Install Bengali fonts
sudo apt install -y fonts-beng

# Find the font file
find /usr/share/fonts -name "*.ttf" | grep -i "beng\|lohit" | head -5

# Create fonts directory and copy font
mkdir -p /var/www/html/specialorganicshop/storage/fonts
cp /usr/share/fonts/truetype/lohit-bengali/Lohit-Bengali.ttf /var/www/html/specialorganicshop/storage/fonts/

# Set permissions
chown www-data:www-data /var/www/html/specialorganicshop/storage/fonts/Lohit-Bengali.ttf



cd /var/www/html/specialorganicshop
php artisan view:clear

ls -la /var/www/html/specialorganicshop/storage/fonts/


# Alternative - download Kalpurush (popular BD font)
sudo apt install -y wget
wget -O /var/www/html/specialorganicshop/storage/fonts/kalpurush.ttf \
  "https://github.com/hablullah/go-data-bengali/raw/master/font/Kalpurush.ttf"








