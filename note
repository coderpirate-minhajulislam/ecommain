php artisan tinker --execute='Schema::table("products", function ($t) { $t->index(["in_stock", "is_featured"]); $t->index(["in_stock", "is_new_arrival"]); $t->index(["in_stock", "offer_timer"]); $t->index("created_at"); $t->index("price"); }); echo "Done products";'

# BANNERS TABLE
php artisan tinker --execute='Schema::table("banners", function ($t) { $t->index(["is_active", "position", "sort_order"]); }); echo "Done banners";'

# CONTACT MESSAGES TABLE
php artisan tinker --execute='Schema::table("contact_messages", function ($t) { $t->index("is_read"); }); echo "Done contact_messages";'

# COUPONS TABLE
php artisan tinker --execute='Schema::table("coupons", function ($t) { $t->index(["is_active", "is_global"]); }); echo "Done coupons";'

# PAYMENT METHODS TABLE
php artisan tinker --execute='Schema::table("payment_methods", function ($t) { $t->index(["is_active", "sort_order"]); }); echo "Done payment_methods";'

# USERS TABLE
php artisan tinker --execute='Schema::table("users", function ($t) { $t->index("role"); }); echo "Done users";'

# REVIEWS TABLE (composite)
php artisan tinker --execute='Schema::table("reviews", function ($t) { $t->index(["product_id", "is_approved"]); }); echo "Done reviews";'

